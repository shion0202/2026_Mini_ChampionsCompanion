exports[`파티 편집 화면은 빈 자리를 빈 자리로 보여준다 1`] = `
"<form class=\\"builds-editor\\" data-builds-form=\\"party\\"><label class=\\"builds-field\\">이름<input type=\\"text\\" value=\\"스카프 선공 구축\\" data-builds-field=\\"name\\" placeholder=\\"파티명\\"></label><fieldset class=\\"builds-members\\"><legend>구성</legend><ul><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">1</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"0\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">물리형 보만다</span><small class=\\"builds-sub\\">보만다</small></span></button><button type=\\"button\\" class=\\"icon-button builds-member-edit\\" data-builds-member-edit=\\"aaaaaaaaaaaaaaaa\\" aria-label=\\"물리형 보만다 샘플 편집\\">✎</button></div><details class=\\"builds-member-more\\"><summary>상세</summary><dl class=\\"builds-member-facts\\"><div><dt>도구</dt><dd>구애스카프</dd></div><div><dt>특성</dt><dd>위협</dd></div><div><dt>능력 보정</dt><dd>고집 (공격 ↑ 특수공격 ↓)</dd></div><div><dt>능력 포인트</dt><dd>A32 D2 S32</dd></div><div><dt>기술</dt><dd>드래곤클로 / 지진 / 용의춤 / 날개쉬기</dd></div></dl></details></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">2</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"1\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">3</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"2\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">4</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"3\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">5</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"4\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">6</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"5\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li></ul></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"특정 포켓몬을 파티에 채용한 이유 등\\">선공을 잡고 굳히는 구성이다.</textarea></label><ul class=\\"builds-errors notice\\" data-builds-errors hidden></ul><div class=\\"builds-actions\\"><button type=\\"submit\\" class=\\"primary-button\\" data-builds-save>저장</button><button type=\\"button\\" class=\\"text-button\\" data-builds-reset>초기화</button><button type=\\"button\\" class=\\"text-button\\" data-builds-cancel>목록으로</button></div></form>"
`;

exports[`파티 편집기도 같은 인자 모양을 쓴다 1`] = `
"<form class=\\"builds-editor\\" data-builds-form=\\"party\\"><label class=\\"builds-field\\">이름<input type=\\"text\\" value=\\"스카프 선공 구축\\" data-builds-field=\\"name\\" placeholder=\\"파티명\\"></label><fieldset class=\\"builds-members\\"><legend>구성</legend><ul><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">1</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"0\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">물리형 보만다</span><small class=\\"builds-sub\\">보만다</small></span></button><button type=\\"button\\" class=\\"icon-button builds-member-edit\\" data-builds-member-edit=\\"aaaaaaaaaaaaaaaa\\" aria-label=\\"물리형 보만다 샘플 편집\\">✎</button></div><details class=\\"builds-member-more\\"><summary>상세</summary><dl class=\\"builds-member-facts\\"><div><dt>도구</dt><dd>구애스카프</dd></div><div><dt>특성</dt><dd>위협</dd></div><div><dt>능력 보정</dt><dd>고집 (공격 ↑ 특수공격 ↓)</dd></div><div><dt>능력 포인트</dt><dd>A32 D2 S32</dd></div><div><dt>기술</dt><dd>드래곤클로 / 지진 / 용의춤 / 날개쉬기</dd></div></dl></details></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">2</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"1\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">3</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"2\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">4</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"3\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">5</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"4\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li><li class=\\"builds-member\\"><div class=\\"builds-member-head\\"><span class=\\"builds-slot\\">6</span><button type=\\"button\\" class=\\"builds-pick builds-member-pick\\" data-builds-member=\\"5\\"><span class=\\"no-portrait\\" aria-hidden=\\"true\\">◇</span><span class=\\"builds-text\\"><span class=\\"builds-name\\">빈 자리</span></span></button></div></li></ul></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"특정 포켓몬을 파티에 채용한 이유 등\\">선공을 잡고 굳히는 구성이다.</textarea></label><ul class=\\"builds-errors notice\\" data-builds-errors><li>이름을 입력하세요.</li></ul><div class=\\"builds-actions\\"><button type=\\"submit\\" class=\\"primary-button\\" data-builds-save>저장</button><button type=\\"button\\" class=\\"text-button\\" data-builds-reset>초기화</button><button type=\\"button\\" class=\\"text-button builds-delete\\" data-builds-delete>삭제</button><button type=\\"button\\" class=\\"text-button\\" data-builds-cancel>목록으로</button></div></form>"
`;
