lass=\\"builds-points\\"><legend>능력 포인트 <small>합계 0 / 66</small></legend><label class=\\"builds-point\\"><span>H</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"0\\"></label><label class=\\"builds-point\\"><span>A</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"1\\"></label><label class=\\"builds-point\\"><span>B</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"2\\"></label><label class=\\"builds-point\\"><span>C</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"3\\"></label><label class=\\"builds-point\\"><span>D</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"4\\"></label><label class=\\"builds-point\\"><span>S</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"5\\"></label></fieldset><fieldset class=\\"builds-moves\\"><legend>채용 기술</legend><ul><li><span class=\\"builds-slot\\">1</span><button class=\\"builds-pick\\" data-builds-move=\\"0\\">기술 선택</button></li><li><span class=\\"builds-slot\\">2</span><button class=\\"builds-pick\\" data-builds-move=\\"1\\">기술 선택</button></li><li><span class=\\"builds-slot\\">3</span><button class=\\"builds-pick\\" data-builds-move=\\"2\\">기술 선택</button></li><li><span class=\\"builds-slot\\">4</span><button class=\\"builds-pick\\" data-builds-move=\\"3\\">기술 선택</button></li></ul></fieldset><fieldset class=\\"builds-alts\\"><legend>후보 기술</legend><ul></ul><button type=\\"button\\" class=\\"text-button\\" data-builds-alt-add>후보 기술 추가</button></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"보정과 포인트의 의도, 기술의 의도, 후보 기술인 이유 등\\"></textarea></label><div class=\\"builds-actions\\"><button type=\\"submit\\" class=\\"primary-button\\" data-builds-save>저장</