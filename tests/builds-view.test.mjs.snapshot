exports[`빈 샘플 편집 화면은 통계 값을 미리 채우지 않는다 1`] = `
"<form class=\\"builds-editor\\" data-builds-form=\\"sample\\"><label class=\\"builds-field\\">이름<input type=\\"text\\" value=\\"\\" data-builds-field=\\"name\\" placeholder=\\"예: 스카프 보만다\\"></label><button type=\\"button\\" class=\\"builds-pick builds-species\\" data-builds-species>포켓몬 미선택</button><button type=\\"button\\" class=\\"builds-pick\\" data-builds-ability>특성 고르기</button><button type=\\"button\\" class=\\"builds-pick\\" data-builds-nature>보정 미선택</button><fieldset class=\\"builds-points\\"><legend>능력 포인트 <small>합계 0 / 66</small></legend><label class=\\"builds-point\\"><span>H</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"0\\"></label><label class=\\"builds-point\\"><span>A</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"1\\"></label><label class=\\"builds-point\\"><span>B</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"2\\"></label><label class=\\"builds-point\\"><span>C</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"3\\"></label><label class=\\"builds-point\\"><span>D</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"4\\"></label><label class=\\"builds-point\\"><span>S</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"5\\"></label></fieldset><fieldset class=\\"builds-moves\\"><legend>채용 기술</legend><ul><li><span class=\\"builds-slot\\">1</span><button class=\\"builds-pick\\" data-builds-move=\\"0\\">기술 고르기</button></li><li><span class=\\"builds-slot\\">2</span><button class=\\"builds-pick\\" data-builds-move=\\"1\\">기술 고르기</button></li><li><span class=\\"builds-slot\\">3</span><button class=\\"builds-pick\\" data-builds-move=\\"2\\">기술 고르기</button></li><li><span class=\\"builds-slot\\">4</span><button class=\\"builds-pick\\" data-builds-move=\\"3\\">기술 고르기</button></li></ul></fieldset><fieldset class=\\"builds-alts\\"><legend>후보 기술</legend><ul></ul><button type=\\"button\\" class=\\"text-button\\" data-builds-alt-add>후보 더하기</button></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"보정과 포인트의 의도, 기술의 의도, 후보 기술인 이유\\"></textarea></label></form>"
`;

exports[`샘플 목록은 이름, 포켓몬, 배분 요약을 보여준다 1`] = `
