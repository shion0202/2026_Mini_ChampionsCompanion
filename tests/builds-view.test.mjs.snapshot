`;

exports[`샘플 편집 화면은 채용 기술과 후보 기술을 나눠 보여준다 1`] = `
"<form class=\\"builds-editor\\" data-builds-form=\\"sample\\"><label class=\\"builds-field\\">이름<input type=\\"text\\" value=\\"물리형 보만다\\" data-builds-field=\\"name\\" placeholder=\\"예: 스카프 보만다\\"></label><button type=\\"button\\" class=\\"builds-pick builds-species\\" data-builds-species>보만다</button><button type=\\"button\\" class=\\"builds-pick\\" data-builds-ability>위협</button><button type=\\"button\\" class=\\"builds-pick\\" data-builds-nature>고집 (공격 ↑ 특수공격 ↓)</button><fieldset class=\\"builds-points\\"><legend>능력 포인트 <small>합계 66 / 66</small></legend><label class=\\"builds-point\\"><span>H</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"0\\"></label><label class=\\"builds-point\\"><span>A</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"32\\" data-builds-point=\\"1\\"></label><label class=\\"builds-point\\"><span>B</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"2\\"></label><label class=\\"builds-point\\"><span>C</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"0\\" data-builds-point=\\"3\\"></label><label class=\\"builds-point\\"><span>D</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"2\\" data-builds-point=\\"4\\"></label><label class=\\"builds-point\\"><span>S</span><input type=\\"number\\" min=\\"0\\" max=\\"32\\" step=\\"1\\" value=\\"32\\" data-builds-point=\\"5\\"></label></fieldset><fieldset class=\\"builds-moves\\"><legend>채용 기술</legend><ul><li><span class=\\"builds-slot\\">1</span><button class=\\"builds-pick\\" data-builds-move=\\"0\\">Dragon Claw</button></li><li><span class=\\"builds-slot\\">2</span><button class=\\"builds-pick\\" data-builds-move=\\"1\\">Earthquake</button></li><li><span class=\\"builds-slot\\">3</span><button class=\\"builds-pick\\" data-builds-move=\\"2\\">Dragon Dance</button></li><li><span class=\\"builds-slot\\">4</span><button class=\\"builds-pick\\" data-builds-move=\\"3\\">Roost</button></li></ul></fieldset><fieldset class=\\"builds-alts\\"><legend>후보 기술</legend><ul><li><span>Fire Fang</span><button type=\\"button\\" class=\\"text-button\\" data-builds-alt-remove=\\"Fire Fang\\">빼기</button></li><li><span>Crunch</span><button type=\\"button\\" class=\\"text-button\\" data-builds-alt-remove=\\"Crunch\\">빼기</button></li></ul><button type=\\"button\\" class=\\"text-button\\" data-builds-alt-add>후보 더하기</button></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"보정과 포인트의 의도, 기술의 의도, 후보 기술인 이유\\">스카프로 선공을 잡는다.\\n후보는 상성 보완역이라 4번째와 자유롭게 바꾼다.</textarea></label></form>"
`;

exports[`파티 목록은 채운 자리 수를 보여준다 1`] = `
"<ul class=\\"builds-list\\"><li class=\\"builds-row\\"><button class=\\"builds-open\\" data-builds-party=\\"p1p1p1p1p1p1p1p1\\"><span class=\\"builds-name\\">스카프 선공 구축</span><small class=\\"builds-sub\\">1/6 · 물리형 보만다</small></button></li></ul>"
`;

exports[`파티 편집 화면은 빈 자리를 빈 자리로 보여준다 1`] = `
"<form class=\\"builds-editor\\" data-builds-form=\\"party\\"><label class=\\"builds-field\\">이름<input type=\\"text\\" value=\\"스카프 선공 구축\\" data-builds-field=\\"name\\" placeholder=\\"예: 스카프 선공 구축\\"></label><fieldset class=\\"builds-members\\"><legend>구성</legend><ul><li><span class=\\"builds-slot\\">1</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"0\\">물리형 보만다</button></li><li><span class=\\"builds-slot\\">2</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"1\\">빈 자리</button></li><li><span class=\\"builds-slot\\">3</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"2\\">빈 자리</button></li><li><span class=\\"builds-slot\\">4</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"3\\">빈 자리</button></li><li><span class=\\"builds-slot\\">5</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"4\\">빈 자리</button></li><li><span class=\\"builds-slot\\">6</span><button type=\\"button\\" class=\\"builds-pick\\" data-builds-member=\\"5\\">빈 자리</button></li></ul></fieldset><label class=\\"builds-field\\">설명<textarea rows=\\"5\\" data-builds-field=\\"note\\" placeholder=\\"왜 이런 조합인지\\">선공을 잡고 굳히는 구성이다.</textarea></label></form>"
`;
